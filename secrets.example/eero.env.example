# Eero cloud API token for the collector (read-only GETs). Run `python tools/eero_login.py` on your PC: Eero texts a code to the
# account's phone number and the token goes to your OS keychain. Copy it from there to /srv/homelab/secrets/eero.env (chmod 600).
# Accounts that sign in with Amazon can't use this: invite another admin with a phone number and use theirs.
EERO_SESSION=replace_me
