# Caddy gets the wildcard certificate with the Porkbun DNS challenge; the collector uses the same keys READ-ONLY for domain/DNS checks.
# Create an API key at porkbun.com and enable API access on the domain. Copy to /srv/homelab/secrets/porkbun.env (chmod 600).
PORKBUN_API_KEY=pk1_replace_me
PORKBUN_API_SECRET_KEY=sk1_replace_me
