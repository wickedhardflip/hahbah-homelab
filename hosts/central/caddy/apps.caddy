# Generated from apps.yaml by `python -m app.caddygen`. Do not edit by hand.

@jobs host jobs.hahbah.com
@xsite_jobs expression {method} in ['POST', 'PUT', 'PATCH', 'DELETE'] && {header.Origin} != '' && {header.Origin} != 'https://jobs.hahbah.com'
handle @jobs {
	route {
		respond @xsite_jobs 403
		request_header -Remote-User
		request_header -X-Homelab-Proxy
		forward_auth portal:8000 {
			uri /auth/verify?role=admin
			copy_headers Remote-User
		}
		reverse_proxy host.docker.internal:8080 {
			header_up X-Homelab-Proxy {env.HOMELAB_PROXY_SECRET}
			header_up Cookie "(^|;)\s*hl_session\s*=[^;]*" "$1"
			header_down Set-Cookie "^\s*hl_session\s*=.*" ""
		}
	}
}

